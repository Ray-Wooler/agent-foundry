NODE_ENV=development
DATABASE_URL=postgres://foundry:foundry@localhost:5432/foundry
API_PORT=3001
WEB_PORT=3000
API_PUBLIC_URL=http://localhost:3001
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_WORKSPACE_NAME=Default Workspace
SESSION_TTL_HOURS=24
WORKER_POLL_MS=1000

PROMPTFORGE_PROVIDER=deterministic
# Set to openai in a credentialed environment:
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Required for Phase 6 FrankAI registration action:
# FRANKAI_REGISTRY_URL=https://frankai.example/v1/agent-releases

# Production durable artifact storage (S3-compatible):
# OBJECT_STORAGE_ENDPOINT=https://s3.example.com
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_BUCKET=agent-foundry
# OBJECT_STORAGE_FORCE_PATH_STYLE=false
# OBJECT_STORAGE_ACCESS_KEY_FILE=/run/secrets/object_storage_access_key
# OBJECT_STORAGE_SECRET_KEY_FILE=/run/secrets/object_storage_secret_key
