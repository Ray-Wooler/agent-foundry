{
  "name": "@agent-foundry/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm --filter @agent-foundry/db build && pnpm --filter @agent-foundry/domain build && pnpm --filter @agent-foundry/promptforge build && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "@agent-foundry/db": "workspace:*",
    "@agent-foundry/domain": "workspace:*",
    "@agent-foundry/promptforge": "workspace:*"
  }
}
