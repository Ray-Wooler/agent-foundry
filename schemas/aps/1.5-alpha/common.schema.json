{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://foundry.frankai.online/schemas/aps/1.5-alpha/common.schema.json",
  "title":"APS v1.5-alpha Common Definitions",
  "$defs":{
    "nonEmptyString":{"type":"string","minLength":1},
    "stringArray":{"type":"array","items":{"type":"string"}},
    "capability":{
      "type":"object","additionalProperties":false,
      "required":["id","description"],
      "properties":{
        "id":{"$ref":"#/$defs/nonEmptyString"},
        "description":{"$ref":"#/$defs/nonEmptyString"},
        "inputs":{"$ref":"#/$defs/stringArray"},
        "outputs":{"$ref":"#/$defs/stringArray"},
        "preconditions":{"$ref":"#/$defs/stringArray"},
        "required_permissions":{"$ref":"#/$defs/stringArray"},
        "side_effect_classes":{"$ref":"#/$defs/stringArray"},
        "evidence_requirements":{"$ref":"#/$defs/stringArray"},
        "acceptance_criteria":{"$ref":"#/$defs/stringArray"}
      }
    },
    "authority":{
      "type":"object","additionalProperties":false,
      "required":["recommendation","execution","delegation"],
      "properties":{
        "recommendation":{"$ref":"#/$defs/stringArray"},
        "execution":{"$ref":"#/$defs/stringArray"},
        "delegation":{"$ref":"#/$defs/stringArray"},
        "approval_required":{"$ref":"#/$defs/stringArray"},
        "prohibited":{"$ref":"#/$defs/stringArray"}
      }
    },
    "clarificationPolicy":{
      "type":"object","additionalProperties":false,
      "required":["ask_when","question_selection"],
      "properties":{
        "ask_when":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonEmptyString"}},
        "do_not_ask_when":{"$ref":"#/$defs/stringArray"},
        "question_selection":{"$ref":"#/$defs/nonEmptyString"}
      }
    },
    "answerabilityPolicy":{
      "type":"object","additionalProperties":false,
      "required":["required_information","acceptable_assumptions","prohibited_assumptions","clarification","retrieval_conditions","abstention_conditions","consolidation_strategy","state_taxonomy"],
      "properties":{
        "required_information":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonEmptyString"}},
        "acceptable_assumptions":{"$ref":"#/$defs/stringArray"},
        "prohibited_assumptions":{"$ref":"#/$defs/stringArray"},
        "clarification":{"$ref":"#/$defs/clarificationPolicy"},
        "retrieval_conditions":{"$ref":"#/$defs/stringArray"},
        "abstention_conditions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonEmptyString"}},
        "consolidation_strategy":{"$ref":"#/$defs/nonEmptyString"},
        "state_taxonomy":{"type":"array","minItems":4,"uniqueItems":true,"items":{"enum":["MISSING_USER_INFORMATION","MISSING_EVIDENCE","AMBIGUOUS_REQUIREMENT","CONFLICTING_EVIDENCE","EPISTEMIC_UNKNOWN","INSUFFICIENT_TOOL_ACCESS","INSUFFICIENT_AUTHORITY","READY_TO_ANSWER","READY_TO_ACT"]}}
      }
    },
    "preExecutionConsolidation":{
      "type":"object","additionalProperties":false,
      "required":["required","fail_closed","include"],
      "properties":{
        "required":{"type":"boolean"},
        "fail_closed":{"type":"boolean"},
        "include":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonEmptyString"}}
      }
    },
    "temporalValidity":{
      "type":"object","additionalProperties":false,
      "properties":{
        "observed_at":{"type":["string","null"],"format":"date-time"},
        "valid_from":{"type":["string","null"],"format":"date-time"},
        "valid_until":{"type":["string","null"],"format":"date-time"},
        "review_after":{"type":["string","null"],"format":"date-time"},
        "stale_after":{"type":["string","null"],"format":"date-time"}
      }
    },
    "claim":{
      "type":"object","additionalProperties":false,
      "required":["id","statement","type","status"],
      "properties":{
        "id":{"$ref":"#/$defs/nonEmptyString"},
        "statement":{"$ref":"#/$defs/nonEmptyString"},
        "type":{"enum":["observation","finding","assessment","attribution","forecast","recommendation"]},
        "status":{"enum":["PROPOSED","SUPPORTED","DISPUTED","SUPERSEDED","WITHDRAWN"]},
        "evidence_for":{"$ref":"#/$defs/stringArray"},
        "evidence_against":{"$ref":"#/$defs/stringArray"},
        "assumptions":{"$ref":"#/$defs/stringArray"},
        "confidence":{"type":["string","null"]},
        "temporal_validity":{"$ref":"#/$defs/temporalValidity"}
      }
    }
  }
}