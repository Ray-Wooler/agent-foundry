{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://foundry.frankai.online/schemas/aps/1.5-alpha/agent.schema.json",
  "title":"Agent Prompt Specification v1.5-alpha",
  "type":"object",
  "additionalProperties":false,
  "required":["aps_version","agent","mandate","capabilities","governance"],
  "properties":{
    "aps_version":{"const":"1.5-alpha"},
    "agent":{
      "type":"object","additionalProperties":false,
      "required":["id","name","version","class"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "name":{"type":"string","minLength":1},
        "version":{"type":"string","minLength":1},
        "class":{"enum":["orchestrator","specialist","builder","analyst","advisor","monitor","communicator","reviewer"]},
        "description":{"type":"string"}
      }
    },
    "mandate":{
      "type":"object","additionalProperties":false,
      "required":["purpose","primary_objective"],
      "properties":{
        "purpose":{"type":"string","minLength":1},
        "primary_objective":{"type":"string","minLength":1},
        "secondary_objectives":{"type":"array","items":{"type":"string"}},
        "non_goals":{"type":"array","items":{"type":"string"}}
      }
    },
    "capabilities":{"type":"array","items":{"$ref":"common.schema.json#/$defs/capability"}},
    "governance":{
      "type":"object","additionalProperties":false,
      "required":["authority"],
      "properties":{
        "authority":{"$ref":"common.schema.json#/$defs/authority"},
        "policies":{"type":"array","items":{"type":"string"}}
      }
    },
    "epistemic":{
      "type":"object","additionalProperties":false,
      "properties":{"claims":{"type":"array","items":{"$ref":"common.schema.json#/$defs/claim"}}}
    },
    "operational":{"type":"object"},
    "extensions":{"type":"object"}
  }
}