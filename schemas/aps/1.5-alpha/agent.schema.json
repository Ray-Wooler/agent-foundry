{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.frankai.online/schemas/aps/1.5-alpha/agent.schema.json",
  "title": "Agent Prompt Specification v1.5-alpha",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aps_version",
    "agent",
    "mandate",
    "capabilities",
    "governance"
  ],
  "properties": {
    "aps_version": {
      "const": "1.5-alpha"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "class"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "enum": [
            "orchestrator",
            "specialist",
            "builder",
            "analyst",
            "advisor",
            "monitor",
            "communicator",
            "reviewer"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "mandate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "primary_objective"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "primary_objective": {
          "type": "string",
          "minLength": 1
        },
        "secondary_objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/capability"
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority"
      ],
      "properties": {
        "authority": {
          "$ref": "common.schema.json#/$defs/authority"
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retrieved_content_is_data": {
          "type": "boolean"
        }
      }
    },
    "epistemic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement",
              "type",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "observation",
                  "finding",
                  "assessment",
                  "attribution",
                  "forecast",
                  "recommendation"
                ]
              },
              "status": {
                "enum": [
                  "PROPOSED",
                  "SUPPORTED",
                  "DISPUTED",
                  "SUPERSEDED",
                  "WITHDRAWN"
                ]
              },
              "evidence_for": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence_against": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "confidence": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "temporal_validity": {
                "$ref": "common.schema.json#/$defs/temporalValidity"
              },
              "corroborated": {
                "type": "boolean"
              },
              "source_lineages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "freshness_material": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "operational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "operations"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "permission": {
                      "type": "string"
                    },
                    "authority": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "side_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "consequence"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "consequence": {
                "enum": [
                  "NONE",
                  "LOW",
                  "MODERATE",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "authority_grant": {
                "type": "string"
              }
            }
          }
        },
        "persistent_state": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "authoritative_store": {
                "type": "string"
              }
            }
          }
        },
        "executions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "PROPOSED",
                  "IMPLEMENTED",
                  "TESTED",
                  "VERIFIED",
                  "DEPLOYED",
                  "OBSERVED"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "verification_evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object"
    },
    "imported_content": {
      "type": "boolean"
    }
  }
}
