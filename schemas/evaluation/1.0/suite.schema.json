{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://foundry.frankai.online/schemas/evaluation/1.0/suite.schema.json",
  "title":"Agent Foundry Evaluation Suite v1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["suite_id","version","name","class","cases","policy"],
  "properties":{
    "suite_id":{"type":"string","minLength":1},
    "version":{"type":"string","minLength":1},
    "name":{"type":"string","minLength":1},
    "class":{"enum":["CONFORMANCE","FUNCTIONAL","BOUNDARY","ADVERSARIAL","REGRESSION","OUTCOME"]},
    "description":{"type":"string"},
    "cases":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["case_id","name","input","assertions"],
      "properties":{
        "case_id":{"type":"string","minLength":1},
        "name":{"type":"string","minLength":1},
        "input":{},
        "assertions":{"type":"array","minItems":1,"items":{
          "type":"object","additionalProperties":false,
          "required":["assertion_id","type","required"],
          "properties":{
            "assertion_id":{"type":"string","minLength":1},
            "type":{"enum":["JSON_PATH","REGEX","EXACT","SEMANTIC","HUMAN_REVIEW","POLICY"]},
            "required":{"type":"boolean"},
            "expression":{"type":["string","null"]},
            "expected":{},
            "rationale":{"type":"string"}
          }
        }}
      }
    }},
    "policy":{
      "type":"object","additionalProperties":false,
      "required":["required_outcome"],
      "properties":{
        "required_outcome":{"enum":["PASS","PARTIAL"]},
        "allow_not_applicable":{"type":"boolean","default":true},
        "allow_not_tested":{"type":"boolean","default":false}
      }
    }
  }
}
