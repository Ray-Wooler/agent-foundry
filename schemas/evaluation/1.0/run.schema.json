{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://foundry.frankai.online/schemas/evaluation/1.0/run.schema.json",
 "title":"Agent Foundry Evaluation Run v1.0",
 "type":"object","additionalProperties":false,
 "required":["run_id","agent_version","suite","runtime","policy_snapshot","results","outcome","started_at","completed_at"],
 "properties":{
  "run_id":{"type":"string","minLength":1},
  "agent_version":{"type":"string","minLength":1},
  "suite":{"type":"object","required":["suite_id","version"],"properties":{"suite_id":{"type":"string"},"version":{"type":"string"}}},
  "runtime":{"type":"object","required":["target","identity"],"properties":{"target":{"type":"string"},"identity":{"type":"string"},"configuration":{"type":"object"}}},
  "policy_snapshot":{"type":"object","required":["required_outcome","allow_not_tested"],"properties":{"required_outcome":{"enum":["PASS","PARTIAL"]},"allow_not_applicable":{"type":"boolean"},"allow_not_tested":{"type":"boolean"}}},
  "results":{"type":"array","minItems":1,"items":{"type":"object","required":["case_id","assertion_id","assertion_type","required","outcome","evidence"],"properties":{
   "case_id":{"type":"string"},"assertion_id":{"type":"string"},"assertion_type":{"enum":["JSON_PATH","REGEX","EXACT","SEMANTIC","HUMAN_REVIEW","POLICY"]},"required":{"type":"boolean"},"outcome":{"enum":["PASS","PARTIAL","FAIL","NOT_APPLICABLE","NOT_TESTED"]},"evidence":{"type":"array","items":{"type":"string"}},"reviewer":{"type":["object","null"],"properties":{"identity":{"type":"string"},"role":{"type":"string"},"rationale":{"type":"string"}}}
  }}},
  "outcome":{"enum":["PASS","PARTIAL","FAIL","NOT_APPLICABLE","NOT_TESTED"]},
  "started_at":{"type":"string","format":"date-time"},"completed_at":{"type":"string","format":"date-time"}
 }
}
